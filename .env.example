# ==============================================================================
# 🧪 pw_tester - Archivo de Configuración de Entorno (.env.example)
# ==============================================================================
# Copia este archivo como ".env" dentro de la carpeta pw_tester/ y personaliza
# los valores según tu entorno local o de pruebas.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Sitio WordPress
# ------------------------------------------------------------------------------
# URL del sitio WordPress local (ej. Local by Flywheel, Docker o XAMPP).
WP_SITE_URL=https://pquintanilla.local

# Credenciales de Administrador para pruebas de interfaz en navegador (Playwright E2E).
WP_ADMIN_USER=admin
WP_ADMIN_PASS=password

# ------------------------------------------------------------------------------
# 2. Claves de Aplicación de WordPress (Application Passwords)
# ------------------------------------------------------------------------------
# WordPress permite autenticar llamadas a la API REST de forma nativa mediante
# "Claves de Aplicación" (generadas en: Usuarios > Tu perfil > Claves de aplicación).
# Formato: 24 caracteres alfanuméricos con espacios (ej. abcd efgh ijkl mnop qrst uvwx).
WP_APP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# 3. Clave Secreta Personalizada del Plugin (Custom API Key / Webhook Secret)
# ------------------------------------------------------------------------------
# Si el plugin utiliza una clave secreta propia en cabeceras HTTP (ej: X-OSA-API-Key).
PLUGIN_API_KEY=test_osa_secret_key_12345

# ------------------------------------------------------------------------------
# 4. Servidor Mock de LLM / IA (Costo $0 y Cero Latencia)
# ------------------------------------------------------------------------------
# Host y puerto para el servidor simulador local de Ollama / OpenAI.
MOCK_LLM_HOST=127.0.0.1
MOCK_LLM_PORT=11435

# ------------------------------------------------------------------------------
# 5. Binario de PHP para Análisis Estático y Sintaxis
# ------------------------------------------------------------------------------
# Deja vacío para autodetectar el PHP del sistema o especifica la ruta absoluta a php.exe.
# Ejemplo Local WP: C:\Users\patri\AppData\Roaming\Local\lightning-services\php-8.2.29+0\bin\win64\php.exe
PHP_EXECUTABLE=

# ------------------------------------------------------------------------------
# 6. Automatización de Navegador (Playwright E2E)
# ------------------------------------------------------------------------------
# HEADLESS=true ejecuta el navegador en segundo plano (invisible).
# HEADLESS=false abre la ventana gráfica de Chromium para ver los clics en tiempo real.
HEADLESS=true
BROWSER_TIMEOUT=15000
